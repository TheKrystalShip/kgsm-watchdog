# kgsm-watchdog — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Copy to /etc/kgsm-watchdog/kgsm-watchdog.env, edit, and reference it from the unit with
#   EnvironmentFile=/etc/kgsm-watchdog/kgsm-watchdog.env
#
# kgsm-watchdog.settings.json, installed beside the binary, declares every knob with its default.
# A variable here overrides ONE key of that file, spelling its path with "__". A variable naming a
# key the file does not declare binds to nothing and is logged as a probable typo at startup, so a
# misspelling is visible rather than silently inert.
#
# Defaults are shown in [brackets]; uncomment a line only to override it.
# The running binary documents the same list: `kgsm-watchdog --help`.

# ── KGSM integration ──────────────────────────────────────────────────────────
# Absolute path to the kgsm entry point (read, via kgsm-lib, for each instance's spawn config).
# The unit already sets this to the packaged path, and this file is read AFTER the unit's
# Environment= lines — so uncommenting it wins, and an engine anywhere else is how to say so.
#Watchdog__KgsmPath=/usr/bin/kgsm

# NOTE: there is NO privilege drop and NO uid/gid/HOME knobs — the systemd unit runs the daemon as
# the KGSM user directly (User=/Group=) and delegates the cgroup subtree to it (Slice=kgsm.slice,
# Delegate=yes). The runtime is fully rootless; see deploy/kgsm-watchdog.service.

# ── Control socket (filesystem perms are the security boundary) ────────────────
# Control unix-domain socket path.                        [/run/kgsm-watchdog/control.sock]
#Watchdog__SocketPath=/run/kgsm-watchdog/control.sock
# Octal perms applied to the socket (owner+group rw).     [660]
#Watchdog__SocketMode=660

# ── Cgroup layout (rarely changed) ────────────────────────────────────────────
#Watchdog__CgroupMountPoint=/sys/fs/cgroup             # cgroup v2 mount point      [/sys/fs/cgroup]
#Watchdog__CgroupBaseName=kgsm.slice                   # delegated base cgroup      [kgsm.slice]
#Watchdog__CgroupControllers=cpu memory io pids        # base subtree controllers   [cpu memory io pids]
#Watchdog__SupervisorLeaf=supervisor                   # leaf the daemon lives in   [supervisor]

# ── Supervision: crash detection + restart ────────────────────────────────────
# How often each instance's cgroup.events is polled for liveness (ms).   [1000]
#Watchdog__PollIntervalMs=1000
# Restart policy: 'always' restarts any exit (only a deliberate /stop keeps it down);
# 'on-failure' leaves a clean code-0 exit stopped, restarts only crashes.  [always]
#Watchdog__RestartPolicy=always
# First-restart delay; doubles each consecutive failure (ms).            [1000]
#Watchdog__RestartBaseDelayMs=1000
# Ceiling on the exponential restart delay (ms).                         [60000]
#Watchdog__RestartMaxDelayMs=60000
# Consecutive failures before giving up and reporting phase=failed.      [5]
#Watchdog__RestartMaxRetries=5
# Uptime (s) after which a healthy instance's failure streak resets.     [300]
#Watchdog__RestartStabilitySeconds=300
# Post-spawn window (s) where crash-detection is suppressed (slow starts). [10]
#Watchdog__RestartGraceSeconds=10

# ── Boot persistence (replaces systemd enable/WantedBy) ───────────────────────
# Where the desired-running set is persisted. Empty derives it after the privilege drop, under the
# KGSM user's data dir.                        [~/.local/share/kgsm-watchdog/desired-state.json]
#Watchdog__StateFile=

# ── Ingesters (player presence + container lifecycle) ─────────────────────────
# KGSM's instances dir, watched for container event channels. Empty derives it after the privilege
# drop, under the KGSM user's data dir.                    [~/.local/share/kgsm/instances]
#Watchdog__InstancesDir=
# How often presence channels are scanned and tailed (ms).               [1000]
#Watchdog__PlayerPresencePollMs=1000
# How often events/lifecycle.ndjson channels are scanned and tailed (ms). [1000]
#Watchdog__ContainerLifecyclePollMs=1000

# ── Console stream ────────────────────────────────────────────────────────────
# How often /console/{instance}/follow polls the log for new lines (ms). [250]
#Watchdog__ConsolePollMs=250
