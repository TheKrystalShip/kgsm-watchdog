# kgsm-watchdog — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Copy to /etc/kgsm-watchdog/kgsm-watchdog.env, edit, and reference it from the unit with
#   EnvironmentFile=/etc/kgsm-watchdog/kgsm-watchdog.env
# Defaults are shown in [brackets]; uncomment a line only to override it.
# The running binary documents the same list: `kgsm-watchdog --help`.

# ── KGSM integration ──────────────────────────────────────────────────────────
# REQUIRED. Absolute path to kgsm.sh (read, via kgsm-lib, for each instance's spawn config).
KGSM_WATCHDOG_KGSM_PATH=/usr/local/bin/kgsm
# kgsm-lib event socket.                                  [/run/kgsm-watchdog/events.sock]
#KGSM_WATCHDOG_KGSM_SOCKET=/run/kgsm-watchdog/events.sock

# NOTE: there is NO privilege drop and NO uid/gid/HOME knobs any more — the systemd unit runs the
# daemon as the KGSM user directly (User=/Group=) and delegates the cgroup subtree to it
# (Slice=kgsm.slice, Delegate=yes). The runtime is fully rootless; see deploy/kgsm-watchdog.service.

# ── Control socket (filesystem perms are the security boundary) ────────────────
# Control unix-domain socket path.                        [/run/kgsm-watchdog/control.sock]
#KGSM_WATCHDOG_SOCKET=/run/kgsm-watchdog/control.sock
# Octal perms applied to the socket (owner+group rw).     [0660]
#KGSM_WATCHDOG_SOCKET_MODE=660

# ── Cgroup layout (rarely changed) ────────────────────────────────────────────
#KGSM_WATCHDOG_CGROUP_MOUNT=/sys/fs/cgroup            # cgroup v2 mount point        [/sys/fs/cgroup]
#KGSM_WATCHDOG_CGROUP_BASE=kgsm.slice                # delegated base cgroup        [kgsm.slice]
#KGSM_WATCHDOG_CGROUP_CONTROLLERS=cpu memory io pids  # base subtree controllers     [cpu memory io pids]
#KGSM_WATCHDOG_SUPERVISOR_LEAF=supervisor            # leaf the daemon lives in     [supervisor]

# ── Supervision: crash detection + restart ────────────────────────────────────
# How often each instance's cgroup.events is polled for liveness (ms).   [1000]
#KGSM_WATCHDOG_POLL_INTERVAL_MS=1000
# Restart policy: 'always' restarts any exit (only a deliberate /stop keeps it down);
# 'on-failure' leaves a clean code-0 exit stopped, restarts only crashes.  [always]
#KGSM_WATCHDOG_RESTART_POLICY=always
# First-restart delay; doubles each consecutive failure (ms).            [1000]
#KGSM_WATCHDOG_RESTART_BASE_DELAY_MS=1000
# Ceiling on the exponential restart delay (ms).                         [60000]
#KGSM_WATCHDOG_RESTART_MAX_DELAY_MS=60000
# Consecutive failures before giving up and reporting phase=failed.      [5]
#KGSM_WATCHDOG_RESTART_MAX_RETRIES=5
# Uptime (s) after which a healthy instance's failure streak resets.     [300]
#KGSM_WATCHDOG_RESTART_STABILITY_SEC=300
# Post-spawn window (s) where crash-detection is suppressed (slow starts). [10]
#KGSM_WATCHDOG_RESTART_GRACE_SEC=10
