[Unit]
Description=KGSM Watchdog (native game-server supervisor)
Documentation=https://github.com/TheKrystalShip
After=network.target

[Service]
Type=simple
# Native-AOT single-file binary. SYSTEMD-DELEGATION model (PLAN Increment 8): the daemon runs as the
# KGSM user from the start — NO root step, NO privilege drop. systemd places the service in kgsm.slice
# and hands it a DELEGATED cgroup subtree (kgsm.slice/kgsm-watchdog.service): it enables the controllers
# on the slice and chowns the service subtree to User=. The daemon discovers that base from
# /proc/self/cgroup and creates each per-instance cgroup UNDER it (kgsm.slice/kgsm-watchdog.service/<inst>),
# NOT as a sibling under kgsm.slice. That distinction is load-bearing: systemd reconciles a slice's OWN
# cgroup.subtree_control on every `daemon-reload` (stripping the controllers off cgroups it does not
# manage — which made per-server memory metrics read 0), but it leaves the delegated subtree below the
# service untouched.
ExecStart=/opt/kgsm-watchdog/kgsm-watchdog

# Start the daemon in its own install prefix so the process working directory is never "/". The
# daemon pins its content root in code and does not depend on this, but a service left at "/" makes
# any future default-rooted file provider walk the whole filesystem — which, for a provider that
# watches (reloadOnChange), silently consumes one inotify watch per directory out of the same
# per-user budget the supervised game servers draw from.
WorkingDirectory=/opt/kgsm-watchdog

# `systemctl reload` → SIGHUP → the daemon re-execs the freshly-deployed binary IN PLACE (same PID,
# same children, open fds carried across the execve) — a zero-downtime hot-swap, not a process bounce.
# On re-exec the daemon is already in kgsm.slice/kgsm-watchdog.service/supervisor; base discovery folds
# the supervisor leaf back to the same delegated base, so the layout is stable across swaps.
ExecReload=/bin/kill -HUP $MAINPID

# Run as the KGSM user (deploy/deploy.sh rewrites these to the installing user). A uid is also accepted.
# UID/GID are no longer needed — there is no privilege drop; systemd runs us as this user directly.
User=kgsm
Group=kgsm

# Delegated cgroup subtree: systemd creates kgsm.slice + kgsm.slice/kgsm-watchdog.service, enables the
# controllers, and chowns the service subtree to User= so the daemon manages it unprivileged. This is
# what keeps the controllers enabled across daemon-reload (the bug Inc 8 fixes).
Slice=kgsm.slice
Delegate=yes

# REQUIRED: absolute path to kgsm.sh (read-only, via kgsm-lib, for each instance's spawn config). Point
# at the packaged launcher, not a copy under /home. The full reference: `kgsm-watchdog --help`.
Environment=Watchdog__KgsmPath=/usr/bin/kgsm
# Optional: keep the rest of the knobs in a file. The leading '-' makes it optional (no failure if
# absent). Every key here must exist in kgsm-watchdog.settings.json, which declares the daemon's whole
# configurable surface; a variable naming an undeclared key binds to nothing and is warned about at
# startup as a probable typo.
EnvironmentFile=-/etc/kgsm-watchdog/kgsm-watchdog.env

# The control socket lives under /run/kgsm-watchdog. systemd creates it owned by User= — safe now
# that no root→user drop happens (the root-boot unit avoided RuntimeDirectory= because a `reload`
# re-chowned it back to root and broke the dropped daemon's socket bind; with User= that cannot arise).
RuntimeDirectory=kgsm-watchdog
RuntimeDirectoryMode=0750

# Persistent state (the boot-autostart set, the restart counters, the run ledger) lives in
# /var/lib/kgsm-watchdog. systemd creates it before ExecStart owned by User= and exports
# $STATE_DIRECTORY, so provisioning it costs no privilege — the same declaration kgsm-api and
# kgsm-monitor use. It is independent of User=, which setup.sh templates per host, and of whether
# that account has a home directory at all.
StateDirectory=kgsm-watchdog
StateDirectoryMode=0750

Restart=always
RestartSec=2

# KillMode=process is LOAD-BEARING under the delegated layout: the games live UNDER this service's
# cgroup (kgsm.slice/kgsm-watchdog.service/<inst>). The default `control-group` would SIGTERM/SIGKILL
# the whole cgroup on stop/restart — killing every running game. `process` kills ONLY the daemon (the
# main PID); the games keep running and the freshly-started daemon RE-ADOPTS them (LivePopulatedInstances).
# This preserves "games outlive a daemon bounce" — the same property the old root-boot model got for free
# by keeping games OUTSIDE the service cgroup. Stop a *game* with `kgsm stop <inst>`, not by stopping the daemon.
KillMode=process

# ── Rootless lock-in (PLAN Inc 8) ─────────────────────────────────────────────
# The daemon and every game it spawns run as the unprivileged User= with ZERO capabilities — cgroup
# management happens entirely inside the systemd-delegated, user-owned subtree, which needs no privilege.
# Enforce that so it can never silently regress:
#   - NoNewPrivileges: no setuid/setcap binary in the tree can ever gain privilege (covers spawned games too).
#   - CapabilityBoundingSet= (empty): the daemon and its children can hold no capabilities at all.
# (Games bind only high ports; an unprivileged user already cannot bind <1024 without cap_net_bind_service,
# which is intentionally not granted.)
NoNewPrivileges=yes
CapabilityBoundingSet=

# The daemon writes cgroup control files under its delegated subtree, so do NOT enable a read-only /sys
# (ProtectKernelTunables), and do NOT hide /home (ProtectHome) where game-server data may live.
# RestrictAddressFamilies applies to EVERY process the service spawns, not just the daemon: native game
# servers need INET/INET6 for their listen sockets, and the UPnP helper (upnpc) needs them for its SOAP
# call to the IGD. AF_UNIX alone seccomp-kills both ("Address family not supported by protocol").
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
