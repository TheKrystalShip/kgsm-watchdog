<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: small footprint, no JIT, instant start. A supervisor must not
         steal resources from the game servers it spawns, and must come back fast
         after a host reboot. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Workstation, non-concurrent GC. This is an ASP.NET Core (Sdk.Web) app, whose default is
         ServerGarbageCollection=true — and Server GC reserves a heap (plus a background GC thread)
         PER CPU core, so an idle supervisor on a many-core host sat at ~100 MB RSS / ~29 threads
         doing nothing. A 1 Hz cgroup poller allocates next to nothing, so Server GC's throughput is
         pure waste here; Workstation + non-concurrent collapses it to one heap and drops the
         background GC thread. Native AOT never affected this — AOT removes the JIT, not the GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <RootNamespace>TheKrystalShip.KGSM.Watchdog</RootNamespace>
    <AssemblyName>kgsm-watchdog</AssemblyName>
    <Version>1.25.0</Version>

    <!-- The source-generated [LibraryImport] p/invokes (mkfifo/open/write/setres*uid)
         emit unsafe marshalling stubs; no hand-written unsafe code in the project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Binary-size / footprint tuning for the AOT image (cf. ../../stash-lang/Stash.Cli).
         OptimizationPreference=Size (not Speed): a 1 Hz cgroup poller has no hot path to speed up, so
         we trade throughput for a smaller native image (fewer code pages resident). FoldIdenticalMethodBodies
         dedupes generic/marshalling stubs; StripSymbols drops the native symbol table; and we don't do
         distributed tracing, so the Activity propagation infra is trimmed out.
         Deliberately NOT taken from Stash.Cli:
           * IlcInstructionSet=native — bakes in THIS CPU's ISA (non-portable); no perf-critical loop here
             to justify the portability risk for a per-host daemon.
           * EventSourceSupport=false — kept ENABLED so dotnet-counters/-trace can still profile this
             long-lived supervisor in the field (that tooling is how the heap over-commit was diagnosed). -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StripSymbols>true</StripSymbols>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <!-- The leaf config descriptor is generated from WatchdogSettings. These name the two files the
         generator works between; the attribute source, the documentation file the <panel> tags travel
         in, and the build step all come with the package below. -->
    <LeafSettingsFile>kgsm-watchdog.settings.json</LeafSettingsFile>
    <LeafDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-watchdog.leaf.json</LeafDescriptorFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: the descriptor attributes arrive as source and the generator as a tool, and the
         package declares no dependencies, so nothing here reaches the AOT publish. -->
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tell the GC to decommit eagerly on every collection (0-9; 5 = moderate). Pairs with the
         one-shot StartupMemoryTrimmer: the trimmer returns the startup spike, ConserveMemory keeps
         later start/stop bursts from leaving committed-but-free heap on the RSS. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The daemon's settings file, renamed from appsettings.json so it can't collide with a sibling
         ecosystem service's config if they ever share a directory. The Web SDK only auto-copies the
         literal "appsettings.json", so the renamed file needs an explicit item to reach bin/ + publish/.
         Program.cs loads it from AppContext.BaseDirectory; deploy installs it beside the binary. -->
    <Content Update="kgsm-watchdog.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal primitives (CgroupManager, WatchdogOptions) to the test project. -->
    <InternalsVisibleTo Include="Watchdog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single KGSM chokepoint. The watchdog uses kgsm-lib ONLY to READ instance
         spawn config (IInstanceService.GetInstanceInfo) and, later, to watch lifecycle
         events — never to start/stop (that path spawns detached, which is exactly what
         this daemon replaces). The net9 lib is IsAotCompatible, so consuming it from
         this net10 AOT app is a verified pattern (same as kgsm-monitor). -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="4.16.0" />
  </ItemGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitShortSha)' != ''">
      <SourceRevisionId>$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
